{
  "name": "claude-hud",
  "version": "0.9.0",
  "description": "Real-time statusline HUD for Claude Code",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src/",
    "commands/",
    ".claude-plugin/"
  ],
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 bun test",
    "test:stdin": "echo '{\"model\":{\"display_name\":\"Opus\"},\"context_window\":{\"current_usage\":{\"input_tokens\":45000},\"context_window_size\":200000},\"transcript_path\":\"/tmp/test.jsonl\"}' | bun --env-file /dev/null src/index.ts"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "hud"
  ],
  "author": "Jarrod Watts",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
